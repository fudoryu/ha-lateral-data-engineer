# --- Python / uv -------------------------------------------------------------
# uv.lock and .python-version are committed for reproducible installs.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Secrets & local config --------------------------------------------------
.env
.env.*
!.env.example

# --- Agents (personal overrides only; shared config is committed) ------------
.claude/settings.local.json
CLAUDE.local.md

# --- Editors & OS ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# --- Local data (directory kept, contents never committed) -------------------
data/*
!data/.gitkeep
# The report CSVs are the brief's committed sample output (ADR-0034).
!data/outputs/

# --- dbt (ADR-0016) -----------------------------------------------------------
pipelines/*/dbt/target/
pipelines/*/dbt/logs/
pipelines/*/dbt/dbt_packages/
pipelines/*/dbt/.user.yml
